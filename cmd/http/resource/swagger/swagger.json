{
  "swagger": "2.0",
  "info": {
    "title": "wc3-team-follow API",
    "description": "Hand-maintained API spec. Update it whenever routes change.",
    "version": "1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness check",
        "description": "Returns 200 while the process runs; it checks no dependencies",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/response.Health"
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness check",
        "description": "Runs the readiness check of every dependency the container created (database ping, broker connection) within http.readiness_timeout. Returns 503 naming the checks that failed or timed out",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Every dependency is ready",
            "schema": {
              "$ref": "#/definitions/response.Readiness"
            }
          },
          "503": {
            "description": "At least one dependency is not ready",
            "schema": {
              "$ref": "#/definitions/response.Readiness"
            }
          }
        }
      }
    },
    "/example": {
      "get": {
        "summary": "Example placeholder",
        "description": "Demonstrates how to wire handlers",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/response.Example"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "response.Health": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        }
      }
    },
    "response.Readiness": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "unavailable"
          ]
        },
        "failed": {
          "type": "array",
          "description": "Names of the checks that failed or timed out, sorted",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "response.Example": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "examples": {
          "type": "integer"
        }
      }
    }
  }
}
